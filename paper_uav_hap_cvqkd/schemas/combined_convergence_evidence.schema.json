{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact selected-roster publication numerical convergence gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "test_set_used", "validation_state_realization_sha256", "coverage_scope", "coverage_complete_over_enumerated_selected_ensembles", "selection_roster_sha256", "certified_roster", "certified_checkpoint_sha256", "certified_baseline_selection_sha256", "selected_mi_samples_per_symbol", "selected_fock_cutoff", "mi_replications_stable", "all_mi_cases_converged", "all_fock_cases_converged", "all_holevo_threshold_sensitivity_cases_passed", "mi_artifact_sha256", "fock_artifact_sha256", "holevo_threshold_artifact_sha256", "resolved_config_sha256", "n_peak_photons"],
  "properties": {
    "schema_version": {"const": "combined-convergence-evidence-v2"},
    "status": {"const": "exact-selected-roster-convergence-gates-passed"},
    "test_set_used": {"const": false},
    "validation_state_realization_sha256": {"$ref": "#/$defs/sha256"},
    "coverage_scope": {"const": "exact_selected_roster_on_preregistered_validation_realization"},
    "coverage_complete_over_enumerated_selected_ensembles": {"const": true},
    "selection_roster_sha256": {"$ref": "#/$defs/sha256"},
    "certified_roster": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/rosterBinding"}},
    "certified_checkpoint_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
    "certified_baseline_selection_sha256": {"$ref": "#/$defs/sha256"},
    "selected_mi_samples_per_symbol": {"type": "integer", "minimum": 1},
    "selected_fock_cutoff": {"type": "integer", "minimum": 2},
    "mi_replications_stable": {"const": true},
    "all_mi_cases_converged": {"const": true},
    "all_fock_cases_converged": {"const": true},
    "all_holevo_threshold_sensitivity_cases_passed": {"const": true},
    "mi_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "fock_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "holevo_threshold_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "resolved_config_sha256": {"$ref": "#/$defs/sha256"},
    "n_peak_photons": {"type": "number", "exclusiveMinimum": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rosterBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "scheme_or_mode", "source_artifact_sha256", "reconstructed_ensemble_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["baseline", "checkpoint"]},
        "scheme_or_mode": {"type": "string", "minLength": 1},
        "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "reconstructed_ensemble_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
