{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prospective C4-Gram support-threshold protocol audit",
  "type": "object",
  "required": [
    "schema_version", "status", "preregistered_design", "lifecycle_guards",
    "validation_state_realization_sha256", "certification_roster_sha256",
    "state_labels", "support_disagreement_count", "support_agreement_count",
    "support_disagreements", "candidate_threshold_assessment",
    "historical_active_threshold_assessment", "all_fixture_comparison_summary",
    "conclusion_scope", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "support-threshold-protocol-audit-v1"},
    "status": {"const": "PROPOSED_DIAGNOSTIC_ONLY_NOT_FROZEN"},
    "preregistered_design": {
      "type": "object",
      "required": [
        "reference_threshold", "candidate_threshold", "historical_active_threshold",
        "declared_observables", "pass_formula", "relative_error_formula",
        "support_identity_interpretation", "acceptance_interpretation"
      ]
    },
    "lifecycle_guards": {
      "type": "object",
      "required": [
        "publication_training_performed", "test_set_accessed",
        "final_held_out_evaluation_performed", "optimized_mb_grid_performed",
        "baseline_selection_performed", "active_config_changed",
        "physical_or_security_functional_changed"
      ],
      "properties": {
        "publication_training_performed": {"const": false},
        "test_set_accessed": {"const": false},
        "final_held_out_evaluation_performed": {"const": false},
        "optimized_mb_grid_performed": {"const": false},
        "baseline_selection_performed": {"const": false},
        "active_config_changed": {"const": false},
        "physical_or_security_functional_changed": {"const": false}
      }
    },
    "state_labels": {"const": ["bad", "medium", "good"]},
    "support_disagreement_count": {"const": 12},
    "support_agreement_count": {"const": 4},
    "support_disagreements": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "fixture", "ensemble_sha256", "support_changed",
          "reference_retained_rank_by_state", "candidate_retained_rank_by_state",
          "between_threshold_eigenvalues_by_state", "reference_values",
          "candidate_values", "candidate_comparison_to_reference"
        ],
        "properties": {"support_changed": {"const": true}}
      }
    },
    "candidate_threshold_assessment": {
      "type": "object",
      "required": [
        "candidate", "reference", "all_declared_observables_pass",
        "worst_normalized_error_to_frozen_tolerance", "support_identity_passes", "status"
      ],
      "properties": {"status": {"const": "PROPOSED_NOT_APPROVED"}}
    },
    "historical_active_threshold_assessment": {
      "type": "object",
      "required": [
        "active", "reference", "all_declared_observables_pass",
        "worst_normalized_error_to_frozen_tolerance", "status"
      ],
      "properties": {"status": {"const": "HISTORICAL_ACTIVE_INVALID_UNAPPROVED"}}
    },
    "all_fixture_comparison_summary": {"type": "array", "minItems": 16, "maxItems": 16},
    "conclusion_scope": {"type": "string"},
    "provenance": {
      "type": "object",
      "required": ["input_and_source_hashes", "production_artifact_embedded_provenance", "precision"]
    }
  },
  "additionalProperties": false
}
