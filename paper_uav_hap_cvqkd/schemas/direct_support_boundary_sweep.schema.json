{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prospective direct-coordinate support boundary sweep",
  "type": "object",
  "required": [
    "schema_version", "status", "preregistered_design", "lifecycle_guards",
    "validation_state_realization_sha256", "fixture_aggregates",
    "disagreement_fixture_summary", "probe_rows", "runtime_seconds", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "direct-support-boundary-sweep-v1"},
    "status": {"const": "PROPOSED_DIAGNOSTIC_ONLY_NOT_FROZEN"},
    "validation_state_realization_sha256": {
      "type": "string", "pattern": "^[0-9a-f]{64}$"
    },
    "preregistered_design": {"type": "object"},
    "lifecycle_guards": {
      "type": "object",
      "required": [
        "publication_training_performed", "test_set_accessed",
        "optimized_mb_grid_performed", "baseline_selection_performed",
        "active_config_changed", "physical_or_security_functional_changed"
      ],
      "properties": {
        "publication_training_performed": {"const": false},
        "test_set_accessed": {"const": false},
        "optimized_mb_grid_performed": {"const": false},
        "baseline_selection_performed": {"const": false},
        "active_config_changed": {"const": false},
        "physical_or_security_functional_changed": {"const": false}
      },
      "additionalProperties": false
    },
    "fixture_aggregates": {"type": "array", "minItems": 13, "maxItems": 13},
    "disagreement_fixture_summary": {"type": "object"},
    "probe_rows": {"type": "array", "minItems": 3822, "maxItems": 3822},
    "runtime_seconds": {"type": "number", "exclusiveMinimum": 0},
    "provenance": {
      "type": "object",
      "required": ["input_and_source_hashes", "output_path"],
      "properties": {
        "input_and_source_hashes": {"type": "object", "minProperties": 1},
        "output_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
