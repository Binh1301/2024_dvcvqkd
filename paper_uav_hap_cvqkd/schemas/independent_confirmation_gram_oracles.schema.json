{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent confirmation full-support Gram oracles",
  "type": "object",
  "required": [
    "schema_version", "status", "confirmation_roster_sha256",
    "oracle_fixture_rows", "aggregate", "lifecycle_guards", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "independent-confirmation-gram-oracles-v1"},
    "status": {"type": "string"},
    "confirmation_roster_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oracle_fixture_rows": {"type": "array", "minItems": 4, "maxItems": 4},
    "aggregate": {"type": "object"},
    "lifecycle_guards": {
      "type": "object",
      "properties": {
        "threshold_approved": {"const": false},
        "publication_training_performed": {"const": false},
        "final_test_accessed": {"const": false},
        "optimized_mb_grid_performed": {"const": false},
        "baseline_selection_performed": {"const": false}
      },
      "additionalProperties": false
    },
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
