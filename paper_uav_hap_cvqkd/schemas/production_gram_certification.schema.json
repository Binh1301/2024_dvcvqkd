{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production C4-Gram certification",
  "type": "object",
  "required": [
    "schema_version", "status", "is_production_numerical_certification",
    "publication_training_performed", "test_set_used",
    "mb_grid_or_baseline_selection_performed", "production_backend",
    "historical_backend", "candidate_density_eigenvalue_threshold",
    "forward_reference_threshold", "support_plateau_is_formal_certification_gate",
    "forward_replay", "gradient_diagnostic", "all_required_gates_pass",
    "runtime_seconds", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "production-c4-gram-certification-v1"},
    "status": {"const": "PROSPECTIVE_DIAGNOSTIC_NOT_READY"},
    "is_production_numerical_certification": {"const": false},
    "formal_threshold_certification": {"const": false},
    "publication_training_performed": {"const": false},
    "test_set_used": {"const": false},
    "mb_grid_or_baseline_selection_performed": {"const": false},
    "production_backend": {"const": "c4_gram"},
    "historical_backend": {"const": "fock_diagnostic_explicit_only"},
    "candidate_density_eigenvalue_threshold": {"const": 1e-13},
    "forward_reference_threshold": {"const": 1e-14},
    "support_plateau_is_formal_certification_gate": {"const": true},
    "forward_replay": {
      "type": "object",
      "required": [
        "coverage_scope", "future_selected_checkpoint_roster_covered",
        "validation_state_realization_sha256", "certification_roster_sha256",
        "canonical_fixture_count", "all_hash_bindings_match",
        "all_observable_plateaus_pass", "support_identical_fixture_count",
        "support_changed_fixture_count", "high_precision_stress_comparison", "rows"
      ],
      "properties": {
        "future_selected_checkpoint_roster_covered": {"const": false},
        "canonical_fixture_count": {"const": 16},
        "rows": {"type": "array", "minItems": 16, "maxItems": 16}
      }
    },
    "gradient_diagnostic": {
      "type": "object",
      "required": [
        "crn_seed", "mutual_information_sample_count",
        "common_noise_reused_for_center_plus_minus_and_autograd",
        "finite_difference_steps", "finite_difference_rule",
        "all_coordinates_pass", "rows"
      ],
      "properties": {
        "crn_seed": {"const": 202615},
        "mutual_information_sample_count": {"const": 2048},
        "common_noise_reused_for_center_plus_minus_and_autograd": {"const": true},
        "finite_difference_steps": {"const": [0.001, 0.0003, 0.0001, 0.00003, 0.00001, 0.000003]},
        "rows": {"type": "array", "minItems": 9}
      }
    },
    "runtime_seconds": {"type": "number", "exclusiveMinimum": 0},
    "provenance": {"type": "object"}
  }
}
