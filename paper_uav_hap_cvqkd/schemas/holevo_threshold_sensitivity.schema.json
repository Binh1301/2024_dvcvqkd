{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Holevo pseudoinverse-threshold sensitivity evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "test_set_used", "validation_state_realization_sha256", "state_labels", "all_listed_fixtures_pass", "selected_ensemble_certification", "traces", "exact_duplicate_aliases", "mi_evidence_sha256", "fock_evidence_sha256", "convergence_selected_fock_cutoff", "provenance"],
  "properties": {
    "status": {"type": "string"},
    "test_set_used": {"const": false},
    "validation_state_realization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_labels": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"enum": ["bad", "medium", "good"]}},
    "all_listed_fixtures_pass": {"type": "boolean"},
    "selected_ensemble_certification": {"type": "null"},
    "traces": {"type": "object"},
    "exact_duplicate_aliases": {"type": "object", "additionalProperties": {"type": "string"}},
    "mi_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fock_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "convergence_selected_fock_cutoff": {
      "oneOf": [
        {"type": "integer", "minimum": 2},
        {"type": "null"}
      ]
    },
    "provenance": {"type": "object"}
  }
}
