    "V": "1+VA",
    "W": "1+eta_f*VA+eta_f*xi_f",
    "Delta": "V**2+W**2-2*Z**2",
    "D": "(V*W-Z**2)**2",
    "nu_1_2": "sqrt((Delta +/- sqrt(Delta**2-4*D))/2)",
    "nu_3": "sqrt(V*(V-Z**2/W))",
    "g": "(x+1)*log2(x+1)-x*log2(x), continuous g(0)=0",
    "chi_BE": "g((nu_1-1)/2)+g((nu_2-1)/2)-g((nu_3-1)/2)",
    "K_raw": "beta*I_AB-chi_BE; retain negative values",
