+        for changes in [dict(M0=.98),dict(mh=.5),dict(m1=1.1)]:
+            with self.assertRaises(ValueError):a.effective({**self.moments,**changes},self.mb['VA'],.8,.005)
+        for eta,epsilon in [(0.,.005),(1.1,.005),(.8,-.01)]:
