+    def test_quantum_covariance_and_untrusted_loss(self):
+        r=a.evaluate_physical(self.mb,self.moments,.8,.005)
+        gamma=np.array([[r['a'],0,r['Z_worst'],0],[0,r['a'],0,-r['Z_worst']],
