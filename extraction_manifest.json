  "equations": {
    "channel_model": {
      "section": "IV",
      "topic": "Satellite-to-ground optical link",
      "equations": {
        "eq_28": {
          "number": 28,
          "title": "Total Link Distance and Effective Atmosphere Thickness",
          "formula": "L_tot = √[(RE+H_zen)² + (RE+H_ogs)² - 2(RE+H_zen)(RE+H_ogs)cos(a1)]",
          "variables": ["RE", "H_zen", "H_ogs", "H_atm", "θ"],
          "function": "link_geometry()",
          "status": "FOUND"
        },
        "eq_29": {
          "number": 29,
          "title": "Free-Space Diffraction and Hardware Loss",
          "formula": "A_geo [dB] = 10·log₁₀(L_tot²·λ² / (D_T²·D_r²·T_T·(1-L_P)·T_R))",
          "variables": ["L_tot", "λ", "D_T", "D_r", "T_T", "T_R", "L_P"],
          "function": "geometric_loss_dB()",
          "status": "FOUND"
        },
        "eq_30": {
          "number": 30,
          "title": "Mie Scattering Loss (Kruse-Kim Model)",
          "formula": "α_scat(V) = 10·log₁₀(e) · (3.912/V) · (λ₀/λ)^(-p)",
          "variables": ["V", "p"],
          "function": "scattering_loss_dBpkm()",
          "status": "FOUND"
        },
        "eq_31": {
          "number": 31,
          "title": "Scintillation Loss with Aperture Averaging",
          "formula": "A_sci = 4.343·erfinv(2p_thr-1)·√(2·ln(σ²_I+1)) - 0.5·ln(σ²_I+1)",
          "variables": ["σ²_I", "p_thr"],
          "function": "scintillation_loss_dB()",
          "status": "FOUND"
        },
        "eq_32": {
          "number": 32,
          "title": "Aperture-Averaged Scintillation Index",
          "formula": "σ²_I = exp(T₁ + T₂) - 1",
          "variables": ["k", "d", "σ²_R", "Cn2", "Dr", "L_atm"],
          "function": "scintillation_index()",
          "status": "FOUND"
        },
        "eq_33": {
          "number": 33,
          "title": "Total Transmittance",
          "formula": "T = 10^(-(A_geo + A_scat + A_sci)/10)",
          "variables": ["A_geo", "A_scat", "A_sci"],
          "function": "total_transmittance()",
          "status": "FOUND"
        }
      }
    },
    "gm_cvqkd": {
      "section": "II-A",
      "topic": "Gaussian Modulation - Homodyne Detection",
      "equations": {
        "eq_3": {
          "number": 3,
          "title": "Noise Definitions and Detector Parameters",
          "components": [
            {
              "name": "Channel Loss Noise",
              "symbol": "χ_line",
              "formula": "χ_line(T, ε) = 1/T - 1 + ε_ch",
              "units": "SNU",
              "physical_meaning": "Thermal noise from lost modes + excess channel noise"
            },
            {
              "name": "Homodyne Detector Noise",
              "symbol": "χ_hom",
              "formula": "χ_hom = (1 - η + ε_det) / η",
              "units": "SNU",
              "typical_value": 0.6892,
              "physical_meaning": "Detector inefficiency + shot noise"
            },
            {
              "name": "Heterodyne Detector Noise",
              "symbol": "χ_het",
              "formula": "χ_het = (1 + (1-η) + 2·ε_det) / η",
              "units": "SNU",
              "typical_value": 1.3783,
              "physical_meaning": "Factor 2 from measuring both quadratures"
            },
            {
              "name": "Total Homodyne Noise",
              "symbol": "χ_tot",
              "formula": "χ_tot = χ_line + χ_hom / T",
              "units": "SNU",
              "critical": true
            }
          ],
          "status": "FOUND"
        },
        "eq_4": {
          "number": 4,
          "title": "Asymptotic Secret Key Rate - Gaussian Modulation",
          "formula": "K_∞ = β·I_A|B - χ_BE",
          "components": ["mutual_information", "holevo_bound", "reconciliation_efficiency"],
          "function": "skr_gm()",
          "status": "FOUND"
        },
        "eq_6": {
          "number": 6,
          "title": "Holevo Bound - GM Homodyne",
          "formula": "χ_BE = G((λ₁-1)/2) + G((λ₂-1)/2) - G((λ₃-1)/2) - G((λ₄-1)/2)",
          "variables": ["λᵢ (symplectic eigenvalues)"],
          "function": "_holevo_gm_hom()",
          "status": "FOUND"
        },
        "eq_9": {
          "number": 9,
          "title": "Symplectic Eigenvalues (Second Pair) - GM",
          "formula": "λ₃,₄ computed from auxiliary quantities A, D",
          "function": "_holevo_gm_hom()",
          "status": "FOUND"
        },
        "eq_10": {
          "number": 10,
          "title": "Auxiliary Quantities for Symplectic Block",
          "components": ["A_hom", "D_hom"],
          "formula": "C = [A·χ_hom + (V_A+1)·√B + T(V_A+1+χ_line)] / [T(V_A+1+χ_tot)]",
          "function": "_holevo_gm_hom()",
          "status": "FOUND"
        },
        "eq_11": {
          "number": 11,
          "title": "Mutual Information - Homodyne",
          "formula": "I_A|B = 0.5·log₂((V_A + 1 + χ_tot) / (1 + χ_tot))",
          "units": "bits/pulse",
          "function": "_IAB_hom()",
          "status": "FOUND"
        }
      }
    },
    "dm_psk_cvqkd": {
      "section": "II-B",
      "topic": "Discrete Modulation - M-PSK - Homodyne",
      "equations": {
        "eq_12": {
