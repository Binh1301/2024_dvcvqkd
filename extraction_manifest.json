    "dm_qam_cvqkd": {
      "section": "II-C",
      "topic": "Discrete Modulation - M-QAM - Heterodyne",
      "equations": {
        "eq_13": {
          "number": 13,
          "title": "M-QAM Discrete Modulation Alphabet",
          "description": "Rectangular m×m grid on 2D lattice",
          "modulation_formats": ["16-QAM", "64-QAM", "256-QAM"],
          "grid_dimension": "m = √M",
          "function": "_Zstar_qam()",
