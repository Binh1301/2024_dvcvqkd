        "eq_16": {
          "number": 16,
          "title": "Asymptotic SKR - M-QAM Heterodyne",
          "formula": "K_∞ = β·I_A|B^het - χ_BE^QAM",
          "units": "bits/pulse",
          "function": "skr_qam()",
