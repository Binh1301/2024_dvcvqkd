          "function": "_holevo_qam_het()",
          "status": "FOUND"
        },
        "eq_20": {
          "number": 20,
          "title": "Z* Lower Bound - Binomial Distribution",
          "formula": "Z* = 2√T·Tr(ρ) - √(2Tε_ch·w)",
          "function": "_Zstar_qam()",
          "status": "FOUND"
        }
      }
    },
    "reconciliation": {
      "section": "III",
      "topic": "Classical Reconciliation & Finite-Size Effects",
      "equations": {
        "eq_23": {
          "number": 23,
          "title": "Reconciliation Efficiency Model",
          "formula": "β(SNR) = 0.99 - 0.15·γ_lin [for Multilevel Direct]",
          "units": "dimensionless [0, 0.99]",
          "function": "reconciliation_efficiency()",
          "status": "FOUND"
        },
        "eq_24": {
          "number": 24,
          "title": "Finite-Size Secret Key Rate",
          "formula": "K_fin = f_rep·[(1-FER)·β·I_A|B - χ_BE - Δn]",
          "units": "bits/s",
          "function": "finite_size_skr()",
          "status": "FOUND"
        },
        "eq_25": {
          "number": 25,
          "title": "Privacy Amplification Correction",
          "formula": "Δn = O(1/√N)",
          "components": ["D_DISC", "EPS_S", "EPS_SEC"],
          "function": "_dn_privacy()",
          "status": "FOUND"
        },
        "eq_26": {
          "number": 26,
          "title": "Frame Error Rate Model",
          "formula": "FER(SNR) = 0.5·[1 + M₁·arctan(M₂·SNR + M₃)]",
          "parameters": [
            {"M1": 0.8218},
            {"M2": -19.46},
            {"M3": -298.1}
          ],
          "function": "frame_error_rate()",
          "status": "FOUND"
        },
        "eq_27": {
          "number": 27,
          "title": "Signal-to-Noise Ratio Definition",
          "formula": "SNR [dB] = 10·log₁₀(T·V_A/2 / (V_A/2 + (1-T)·χ_tot))",
          "units": "dB",
          "function": "_SNR_dB()",
          "status": "FOUND"
        }
      }
    }
